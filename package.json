{
  "name": "@scotec/vue-unified-rbac",
  "version": "0.3.4",
  "type": "module",
  "engines": {
    "node": ">=22.18.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "npm run type-check && npm run build:lib",
    "build:lib": "vite build && tsc -p tsconfig.lib.json",
    "build:demo": "npm run build:lib && vue-tsc --noEmit && vite build --mode demo",
    "preview": "vite preview --mode demo",
    "type-check": "vue-tsc --noEmit",
    "test": "node --experimental-vm-modules --test tests/*.test.mjs",
    "test:sso": "node --experimental-vm-modules --test tests/sso.test.mjs",
    "prepack": "npm run build",
    "predev": "npm run build:lib"
  },
  "dependencies": {
    "keycloak-js": "^26.2.4"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@vitejs/plugin-vue": "^6.0.0",
    "typescript": "~5.8.0",
    "vite": "^7.0.0",
    "vue-tsc": "^3.0.0",
    "vue": "^3.5.0",
    "pinia": "^3.0.0",
    "vue-router": "^4.5.0",
    "axios": "^1.20.0"
  },
  "description": "Vue RBAC plugin with pluggable authentication, permission store, router guard and directive",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./style.css": "./dist/style.css"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "sideEffects": [
    "**/*.css"
  ],
  "publishConfig": {
    "access": "public"
  },
  "peerDependencies": {
    "vue": "^3.5.0",
    "pinia": "^3.0.0",
    "vue-router": "^4.5.0",
    "axios": "^1.20.0"
  }
}
